# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to version control.

# --- Alpaca API credentials ---
# Get these from https://app.alpaca.markets/paper/dashboard/overview (paper)
# or your live account dashboard.
APCA_API_KEY_ID=your_api_key_id_here
APCA_API_SECRET_KEY=your_api_secret_key_here

# Paper trading endpoint (default, safe). Switch to the live URL only when
# you are ready to trade real money:
#   https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Market data endpoint (same for paper and live)
APCA_DATA_URL=https://data.alpaca.markets

# --- Bot behavior ---
# How often (seconds) the main loop checks for new signals.
POLL_INTERVAL_SECONDS=60

# How often (seconds) the bot checks the market clock for equities.
MARKET_CLOCK_CHECK_SECONDS=30

# Where to write trades.csv, daily_pnl.csv, and bot.log. Defaults to the
# current directory.
LOG_DIR=.

# Log verbosity (bot/live_tick.py). Defaults to INFO if unset or invalid.
# Set to DEBUG to see per-instrument strategy evaluation detail on every
# tick (current price/indicator values vs. thresholds, and why each
# strategy did or didn't signal) -- see the "Logging" section of README.md.
# LOG_LEVEL=DEBUG

# API retry behavior
API_MAX_RETRIES=5
API_BACKOFF_BASE_SECONDS=2.0

# --- Telegram morning/evening reports (bot/reporting/) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts to
#    get a token.
# 2. Message your new bot once from whichever chat should receive reports.
# 3. Visit https://api.telegram.org/bot<token>/getUpdates and read the
#    "chat":{"id": ...} field out of the JSON.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: if set, the morning/evening reports ask Claude to write the
# prose from the computed numbers instead of using the plain template in
# bot/reporting/narrate.py. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
