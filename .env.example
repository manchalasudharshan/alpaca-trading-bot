# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to version control.

# --- Alpaca API credentials ---
# Get these from https://app.alpaca.markets/paper/dashboard/overview (paper)
# or your live account dashboard.
APCA_API_KEY_ID=your_api_key_id_here
APCA_API_SECRET_KEY=your_api_secret_key_here

# Paper trading endpoint (default, safe). Switch to the live URL only when
# you are ready to trade real money:
#   https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Market data endpoint (same for paper and live)
APCA_DATA_URL=https://data.alpaca.markets

# --- Bot behavior ---
# How often (seconds) the main loop checks for new signals.
POLL_INTERVAL_SECONDS=60

# How often (seconds) the bot checks the market clock for equities.
MARKET_CLOCK_CHECK_SECONDS=30

# Where to write trades.csv, daily_pnl.csv, and bot.log. Defaults to the
# current directory.
LOG_DIR=.

# API retry behavior
API_MAX_RETRIES=5
API_BACKOFF_BASE_SECONDS=2.0
